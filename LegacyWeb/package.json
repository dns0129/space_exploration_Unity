{
  "name": "space-exploration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && node scripts/build-site.mjs",
    "test:site": "npm run build:site && node scripts/verify-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:server": "node --test server/*.test.mjs",
    "export": "node scripts/export-standalone.mjs",
    "test:offline": "npm run export && node scripts/verify-standalone.mjs",
    "test:performance": "npm run build && node scripts/verify-performance.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.180.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
